# Database Configuration
# Render-da avtomatik qilib o'rnatiladigan o'zgaruvchi
DATABASE_URL=postgresql://username:password@hostname:port/dbname

# JWT Configuration
# Render tavoftan secure random value bilan avtomatik yaratiladi
JWT_SECRET=generate-a-strong-random-string-min-32-characters

# Telegram Bot Configuration
# sizning Telegram Bot Token-i (BotFather-dan olish)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram Chat ID
# /start komandasini bot-ga yuborganingizdan keyin oladigan raqam
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Application
NODE_ENV=production
