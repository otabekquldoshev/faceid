# Database Configuration
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/auth_db

# App URL for mobile QR and public links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60
AUTH_PASSWORD_RATE_LIMIT_MAX=5
AUTH_OTP_RATE_LIMIT_MAX=5
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX=4
AUTH_FACE_RATE_LIMIT_MAX=10

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Application
NODE_ENV=development
